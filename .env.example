# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER expose to the browser. Used by admin routes.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supplier API (Drip) — create a key at /app/development on the supplier site.
# Server-only: this key can spend your deposit, so it must NEVER be prefixed
# with NEXT_PUBLIC_. Leave blank to disable supplier fulfilment.
# Test with a drip_sk_test_ key and SKU SANDBOX-DEMO-30D before going live.
DRIP_API_KEY=
DRIP_BASE_URL=https://dripclientofficial.dev

# Binance Pay — automatic wallet top-ups. Both values come from the Binance
# Merchant Admin Portal (merchant.binance.com) under Developer > API keys.
# Server-only: the secret key signs requests against your merchant account, so
# it must NEVER be prefixed with NEXT_PUBLIC_.
# Leave both blank and the instant top-up card disappears; manual top-ups keep
# working exactly as before.
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=

# Public URL of the deployed site, used to build the webhook and return URLs
# sent to Binance. Falls back to the incoming request origin when unset, which
# is fine locally but should be set explicitly in production.
NEXT_PUBLIC_SITE_URL=https://your-store.vercel.app

# Store settings
NEXT_PUBLIC_STORE_NAME=SH GAMING STORE
NEXT_PUBLIC_SUPPORT_URL=https://wa.me/920000000000
